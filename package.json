{
  "name": "kanbei-kanban",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c gray,cyan \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:docker": "concurrently -k -n server,web -c gray,cyan \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "serve": "NODE_ENV=production tsx src/server/index.ts",
    "start": "vite build && npm run serve",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.19.6",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
